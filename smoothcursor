#!/usr/bin/env python3
"""smoothcursor - run your shell with a smooth, trailing cursor (no APK needed).

It sits between Termux and your shell, tracks where the cursor is, and paints a
fading trail behind it using normal terminal escape codes.

Commands:
    smoothcursor                      start a shell with the smooth cursor
    smoothcursor set <key> <value>    change a setting (enabled, speed, color, size, width, height)
    smoothcursor autostart on|off     start it automatically in every new session
    smoothcursor uninstall            remove everything and restore stock behavior

Config (optional): ~/.termux/smooth-cursor.conf
    enabled=true     # true / false
    speed=60         # 10-500 ms, lower = faster
    color=#ffffff    # cursor color
    size=100         # 1-100, cursor size in percent of the cell (width / height can be set separately)
"""
import fcntl
import math
import os
import pty
import re
import select
import signal
import struct
import sys
import termios
import time
import tty

try:
    import pyte
    import pyte.graphics as pg
except ImportError:  # never lock the user out of their shell
    sh = os.environ.get("SHELL", "sh")
    sys.stderr.write("smoothcursor: 'pyte' is missing (run: pip install pyte). Starting plain shell.\n")
    os.execvp(sh, [sh])

CONF = os.path.expanduser("~/.termux/smooth-cursor.conf")
ALT_RE = re.compile(rb"\x1b\[\?(?:1049|1047|47)([hl])")

FG = {v: k for k, v in list(pg.FG_ANSI.items()) + list(pg.FG_AIXTERM.items())}
BG = {v: k for k, v in list(pg.BG_ANSI.items()) + list(pg.BG_AIXTERM.items())}


def load_conf():
    conf = {"enabled": "true", "speed": "60", "color": "#ffffff", "size": "100"}
    try:
        with open(CONF) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                v = v.strip()
                if not v.startswith("#"):
                    v = v.split("#", 1)[0].strip()
                conf[k.strip()] = v
    except OSError:
        pass

    def num(key, default, lo, hi):
        try:
            return max(lo, min(hi, float(conf.get(key, default))))
        except ValueError:
            return float(default)

    enabled = conf["enabled"].lower() != "false"
    speed = num("speed", 60, 10, 500)
    size = num("size", 100, 1, 100)
    wp = num("width", size, 1, 100) / 100.0
    hp = num("height", size, 1, 100) / 100.0
    c = conf["color"].lstrip("#")
    try:
        rgb = (int(c[0:2], 16), int(c[2:4], 16), int(c[4:6], 16))
    except (ValueError, IndexError):
        rgb = (255, 255, 255)
    return enabled, speed, rgb, wp, hp


def color_sgr(c, fg):
    table = FG if fg else BG
    if c == "default":
        return "39" if fg else "49"
    if c in table:
        return str(table[c])
    if len(c) == 6:
        try:
            r, g, b = int(c[0:2], 16), int(c[2:4], 16), int(c[4:6], 16)
            return "%d;2;%d;%d;%d" % (38 if fg else 48, r, g, b)
        except ValueError:
            pass
    return "39" if fg else "49"


def cell_bytes(ch, bg_override=None):
    """Escape string that paints one buffer cell (optionally with a forced background)."""
    codes = ["0"]
    if ch.bold:
        codes.append("1")
    if ch.italics:
        codes.append("3")
    if ch.underscore:
        codes.append("4")
    if ch.blink:
        codes.append("5")
    if ch.reverse:
        codes.append("7")
    if ch.strikethrough:
        codes.append("9")
    codes.append(color_sgr(ch.fg, True))
    codes.append(bg_override if bg_override else color_sgr(ch.bg, False))
    return "\x1b[" + ";".join(codes) + "m" + (ch.data or " ")


def get_winsize():
    s = fcntl.ioctl(1, termios.TIOCGWINSZ, b"\0" * 8)
    rows, cols, _, _ = struct.unpack("HHHH", s)
    return max(rows, 1), max(cols, 1)


def set_winsize(fd, rows, cols):
    fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))


# ---------------------------------------------------------------------------
# Glyph table: every candidate glyph with the 8x8 "ink" mask it paints.
# bit index = row * 8 + col (row 0 = top, col 0 = left).
# Each glyph is also usable "inverted" (colors swapped) which paints the complement.
# ---------------------------------------------------------------------------
def _mask(fn):
    m = 0
    for r in range(8):
        for c in range(8):
            if fn(r, c):
                m |= 1 << (r * 8 + c)
    return m


def _quad(ul, ur, ll, lr):
    return _mask(lambda r, c: (ul and r < 4 and c < 4) or (ur and r < 4 and c >= 4)
                 or (ll and r >= 4 and c < 4) or (lr and r >= 4 and c >= 4))


_GLYPHS = [(" ", 0), ("\u2588", _mask(lambda r, c: True))]
for _n, _ch in enumerate("\u258f\u258e\u258d\u258c\u258b\u258a\u2589", 1):          # left 1/8 .. 7/8
    _GLYPHS.append((_ch, _mask(lambda r, c, n=_n: c < n)))
for _n, _ch in enumerate("\u2581\u2582\u2583\u2584\u2585\u2586\u2587", 1):          # lower 1/8 .. 7/8
    _GLYPHS.append((_ch, _mask(lambda r, c, n=_n: r >= 8 - n)))
_GLYPHS += [
    ("\u2594", _mask(lambda r, c: r < 1)), ("\u2595", _mask(lambda r, c: c >= 7)),
    ("\u2580", _mask(lambda r, c: r < 4)), ("\u2590", _mask(lambda r, c: c >= 4)),
    ("\u2598", _quad(1, 0, 0, 0)), ("\u259d", _quad(0, 1, 0, 0)),
    ("\u2596", _quad(0, 0, 1, 0)), ("\u2597", _quad(0, 0, 0, 1)),
    ("\u259a", _quad(1, 0, 0, 1)), ("\u259e", _quad(0, 1, 1, 0)),
    ("\u2599", _quad(1, 0, 1, 1)), ("\u259b", _quad(1, 1, 1, 0)),
    ("\u259c", _quad(1, 1, 0, 1)), ("\u259f", _quad(0, 1, 1, 1)),
]
_FULL = (1 << 64) - 1
_CANDS = []
for _g, _m in _GLYPHS:
    _CANDS.append((_g, _m, False))
    _CANDS.append((_g, _FULL ^ _m, True))
_PICK_CACHE = {}


def pick_glyph(cov):
    """Best (glyph, inverted) for an 8x8 coverage mask."""
    hit = _PICK_CACHE.get(cov)
    if hit is None:
        best = None
        for g, m, inv in _CANDS:
            d = bin(cov ^ m).count("1")
            if best is None or d < best[0]:
                best = (d, g, inv)
        hit = (best[1], best[2])
        _PICK_CACHE[cov] = hit
    return hit


def rasterize(poly, rows, cols):
    """Scanline-fill a polygon (cell units) into {(col,row): 8x8 coverage mask}."""
    cells = {}
    ys = [p[1] for p in poly]
    r0 = max(0, int(math.floor(min(ys))))
    r1 = min(rows - 1, int(math.floor(max(ys))))
    n = len(poly)
    for row in range(r0, r1 + 1):
        for sy in range(8):
            y = row + (sy + 0.5) / 8.0
            xs = []
            for i in range(n):
                x1, y1 = poly[i]
                x2, y2 = poly[(i + 1) % n]
                if (y1 <= y < y2) or (y2 <= y < y1):
                    xs.append(x1 + (y - y1) * (x2 - x1) / (y2 - y1))
            xs.sort()
            for j in range(0, len(xs) - 1, 2):
                sx0 = max(0, int(math.ceil(xs[j] * 8 - 0.5)))
                sx1 = min(cols * 8 - 1, int(math.ceil(xs[j + 1] * 8 - 0.5)) - 1)
                for sx in range(sx0, sx1 + 1):
                    key = (sx >> 3, row)
                    cells[key] = cells.get(key, 0) | (1 << (sy * 8 + (sx & 7)))
    return cells


# DECSCUSR shapes -> (x0, y0, x1, y1) of the cursor inside its cell
# Same proportions Termux uses: underline is 1/4 of the cell height, bar is 1/4 of the width.
THICK = 0.25
# The glyph grid is 8x8 per cell, so anything thinner than ~1/8 of a cell would vanish; keep at least this much.
MIN_DIM = 0.14
SHAPE_RE = re.compile(rb"\x1b\[(\d*) q")
LEAD = 0.2  # leading corners move this much faster than the trailing ones


class Smoother:
    """Tracks the screen and draws our own cursor (real one is hidden) with a Neovide-style smear."""

    def __init__(self, rows, cols, speed, rgb, wp=1.0, hp=1.0):
        self.main = pyte.Screen(cols, rows)
        self.alt = pyte.Screen(cols, rows)
        self.main_stream = pyte.ByteStream(self.main)
        self.alt_stream = pyte.ByteStream(self.alt)
        self.in_alt = False
        self.speed = speed
        self.rgb = rgb
        self.wp, self.hp = wp, hp
        self.shape = "block"
        self.target = None          # (col, row) of the cursor we last animated toward
        self.cx = [0.0] * 4         # animated corner positions (TL, TR, BR, BL)
        self.cy = [0.0] * 4
        self.fac = [1.0] * 4        # per-corner time-constant factor
        self.newline_hint = False   # child output contained a line feed since the last tick
        self.dropping = False       # cursor is dropping in from the row above (after Enter)
        self.drawn = {}             # (col,row) -> escape string currently painted
        self.last = time.monotonic()

    @property
    def screen(self):
        return self.alt if self.in_alt else self.main

    @property
    def stream(self):
        return self.alt_stream if self.in_alt else self.main_stream

    def reset_blank(self, rows, cols):
        """Forget everything (used when the column count changed and Termux re-wrapped all text)."""
        self.main = pyte.Screen(cols, rows)
        self.alt = pyte.Screen(cols, rows)
        self.main_stream = pyte.ByteStream(self.main)
        self.alt_stream = pyte.ByteStream(self.alt)
        self.target = None
        self.drawn = {}

    def resync(self, rows, cols, ry, rx):
        """After a window resize: rebuild the model so it lines up with what Termux really shows.

        (ry, rx) is the real cursor position reported by the terminal. Termux keeps the cursor row
        visible when it resizes, so we shift our copy of the screen by the same amount.
        """
        active = self.screen
        off = ry - active.cursor.y
        moved = {}
        for key, esc in self.drawn.items():
            moved[(key[0], key[1] + off)] = esc

        def rebuild(old, shift):
            new = pyte.Screen(cols, rows)
            for y in range(old.lines):
                ny = y + shift
                if 0 <= ny < rows:
                    for x in range(min(cols, old.columns)):
                        new.buffer[ny][x] = old.buffer[y][x]
            new.mode = set(old.mode)
            new.cursor.attrs = old.cursor.attrs
            new.cursor.hidden = old.cursor.hidden
            return new

        new_main = rebuild(self.main, off if not self.in_alt else 0)
        new_alt = rebuild(self.alt, off if self.in_alt else 0)
        act = new_alt if self.in_alt else new_main
        act.cursor.y = max(0, min(rows - 1, ry))
        act.cursor.x = max(0, min(cols - 1, rx))
        self.main, self.alt = new_main, new_alt
        self.main_stream = pyte.ByteStream(self.main)
        self.alt_stream = pyte.ByteStream(self.alt)
        self.target = None
        self.drawn = moved
        return self.erase()

    def feed(self, data):
        """Feed child output into the tracked screens (alternate-screen + cursor-shape aware)."""
        if b"\n" in data:
            self.newline_hint = True
        for m in SHAPE_RE.finditer(data):
            n = int(m.group(1) or 0)
            if n <= 2:
                self.shape = "block"
            elif n <= 4:
                self.shape = "underline"
            elif n <= 6:
                self.shape = "bar"
        pos = 0
        for m in ALT_RE.finditer(data):
            self.stream.feed(data[pos:m.start()])
            pos = m.end()
            self.in_alt = m.group(1) == b"h"
            if self.in_alt:
                self.alt.reset()
            self.target = None
        self.stream.feed(data[pos:])

    # -- painting helpers -------------------------------------------------
    def _plain(self, x, y):
        ch = self.screen.buffer[y][x]
        return "\x1b[%d;%dH%s" % (y + 1, x + 1, cell_bytes(ch)) if ch.data != "" else ""

    def erase(self):
        """Escape string that removes our cursor by repainting the real cell contents."""
        if not self.drawn:
            return ""
        out = ["\x1b7"]
        for (x, y) in self.drawn:
            if 0 <= y < self.screen.lines and 0 <= x < self.screen.columns:
                out.append(self._plain(x, y))
        out.append("\x1b[0m\x1b8")
        self.drawn = {}
        return "".join(out)

    def _paint(self, x, y, cov, is_target):
        ch = self.screen.buffer[y][x]
        if ch.data == "":
            return ""
        r, g, b = self.rgb
        trail = "38;2;%d;%d;%d" % (r, g, b)
        cellbg = color_sgr(ch.fg if ch.reverse else ch.bg, False)
        if is_target and bin(cov).count("1") >= 56 and self.shape == "block" and self.wp >= 0.99 and self.hp >= 0.99:
            # steady block cursor: show the character in reverse on the cursor color
            bold = "1;" if ch.bold else ""
            return "\x1b[%d;%dH\x1b[0;%s%s;%s;7m%s" % (y + 1, x + 1, bold, trail, cellbg, ch.data or " ")
        glyph, inv = pick_glyph(cov)
        if glyph == " " and not inv:
            return ""
        if inv:
            return "\x1b[%d;%dH\x1b[0;%s;%s;7m%s" % (y + 1, x + 1, trail, cellbg, glyph)
        return "\x1b[%d;%dH\x1b[0;%s;%sm%s" % (y + 1, x + 1, trail, cellbg, glyph)

    def tick(self, bulk=False):
        """Advance the animation one step. Returns (escape string, still_animating)."""
        scr = self.screen
        if scr.cursor.hidden:
            return self.erase(), False

        # Termux keeps the cursor on the last column while a wrap is pending; pyte lets x reach `columns`.
        tx, ty = min(scr.cursor.x, scr.columns - 1), scr.cursor.y
        cw = 1
        here = scr.buffer[ty][tx]
        if here.data == "" and tx > 0:
            tx -= 1          # cursor on the 2nd half of a wide character
            cw = 2
        elif tx + 1 < scr.columns and scr.buffer[ty][tx + 1].data == "" and here.data not in ("", " "):
            cw = 2           # Termux draws the cursor over both cells of a wide character
        if self.shape == "bar":
            w, x0 = THICK * self.wp, 0.0
        else:
            w = cw * self.wp
            x0 = (cw - w) / 2.0
        if self.shape == "underline":
            h = THICK * self.hp
            y0 = 1.0 - h
        elif self.shape == "bar":
            h = self.hp
            y0 = (1.0 - h) / 2.0
        else:
            h = self.hp
            y0 = (1.0 - h) / 2.0
        if h < MIN_DIM:
            y0 -= (MIN_DIM - h) / 2.0 if self.shape != "underline" else (MIN_DIM - h)
            h = MIN_DIM
        if w < MIN_DIM:
            x0 -= (MIN_DIM - w) / 2.0 if self.shape != "bar" else 0.0
            w = MIN_DIM
        x1, y1 = x0 + w, y0 + h
        tcx = [tx + x0, tx + x1, tx + x1, tx + x0]
        tcy = [ty + y0, ty + y0, ty + y1, ty + y1]

        now = time.monotonic()
        dt = min((now - self.last) * 1000.0, 50.0)
        self.last = now

        if self.target is None or bulk:
            self.cx, self.cy = tcx[:], tcy[:]
            self.fac = [1.0] * 4
            self.target = (tx, ty)
        elif self.target != (tx, ty):
            ox, oy = self.target
            if self.newline_hint and not self.in_alt and ty >= oy:
                # Enter / newline: the cursor visibly drops in from the row above, straight down.
                # (also when the screen scrolled and the cursor stays on the last row)
                self.dropping = True
                self.cx = tcx[:]
                self.cy = [v - 1.0 for v in tcy]
                self.fac = [1.3, 1.3, 0.7, 0.7]      # bottom edge leads, top edge trails
            elif self.dropping:
                # the prompt is being printed while we fall: keep falling straight down, no sideways slide
                self.cx = tcx[:]
            else:
                # destination changed: leading corners (facing the move) become fast, trailing ones slow
                mx, my = sum(self.cx) / 4.0, sum(self.cy) / 4.0
                dx, dy = (tx + 0.5) - mx, (ty + 0.5) - my
                norm = math.hypot(dx, dy) or 1.0
                rel = [(-0.5, -0.5), (0.5, -0.5), (0.5, 0.5), (-0.5, 0.5)]
                dots = [(rx * dx + ry * dy) / norm for rx, ry in rel]
                lo, hi = min(dots), max(dots)
                span = hi - lo
                self.fac = [1.0 if span < 1e-6 else LEAD + (1.0 - LEAD) * (1.0 - (d - lo) / span) for d in dots]
            self.target = (tx, ty)
        self.newline_hint = False

        settled = True
        for i in range(4):
            k = 1.0 - math.exp(-dt / (self.speed * self.fac[i]))
            self.cx[i] += (tcx[i] - self.cx[i]) * k
            self.cy[i] += (tcy[i] - self.cy[i]) * k
            if abs(tcx[i] - self.cx[i]) + abs(tcy[i] - self.cy[i]) > 0.03:
                settled = False
        if settled:
            self.cx, self.cy = tcx[:], tcy[:]
            self.dropping = False

        poly = list(zip(self.cx, self.cy))
        cells = rasterize(poly, scr.lines, scr.columns)
        new = {}
        for (x, y), cov in cells.items():
            if 0 <= x < scr.columns and 0 <= y < scr.lines:
                new[(x, y)] = self._paint(x, y, cov, (x, y) == (tx, ty))

        out = ["\x1b7"]
        for (x, y) in self.drawn:
            if (x, y) not in new:
                out.append(self._plain(x, y))
        for key, esc in new.items():
            if self.drawn.get(key) != esc:
                out.append(esc if esc else self._plain(*key))
        out.append("\x1b[0m\x1b8")
        self.drawn = new
        return "".join(out), not settled


HIDE_SHOW_RE = re.compile(rb"\x1b\[\?25[hl]")
DSR_RE = re.compile(rb"\x1b\[(\d+);(\d+)R")


def main():
    if not sys.stdin.isatty():
        os.execvp(os.environ.get("SHELL", "sh"), [os.environ.get("SHELL", "sh")])

    enabled, speed, rgb, wp, hp = load_conf()
    cmd = os.environ.get("SMOOTHCURSOR_CMD")
    argv = ["sh", "-c", cmd] if cmd else [os.environ.get("SHELL", "sh")]
    os.environ["SMOOTHCURSOR"] = "1"

    pid, fd = pty.fork()
    if pid == 0:
        os.execvp(argv[0], argv)

    rows, cols = get_winsize()
    set_winsize(fd, rows, cols)
    sm = Smoother(rows, cols, speed, rgb, wp, hp)

    resized = []
    signal.signal(signal.SIGWINCH, lambda *_: resized.append(1))

    old = termios.tcgetattr(0)
    tty.setraw(0)
    animating = False
    out = sys.stdout.buffer
    awaiting = None    # deadline while we wait for the terminal to report its cursor after a resize
    pending = None

    def emit(s):
        if s:
            out.write(s.encode("utf-8", "replace"))
            out.flush()

    def finish_resize(ry, rx):
        nonlocal awaiting
        rws, cls = pending
        if cls != sm.main.columns:
            # Width changed: Termux re-wrapped every line, our copy of the screen is meaningless.
            # Start over from a blank screen (old text stays in scrollback), like at startup.
            alt = sm.in_alt
            sm.reset_blank(rws, cls)
            sm.in_alt = alt
            emit("\x1b[2J\x1b[H" if alt else "\n" * rws + "\x1b[H")
        else:
            emit(sm.resync(rws, cls, ry, rx))
        set_winsize(fd, rws, cls)   # only now does the child learn the new size and redraw
        awaiting = None

    if enabled:
        # Our model starts empty, so push whatever is on screen into scrollback (like `clear`, history kept)
        # and start from a blank screen with the cursor at the top. Termux's own cursor stays hidden.
        emit("\x1b[?25l" + "\n" * rows + "\x1b[H")
    try:
        while True:
            if resized:
                resized.clear()
                if enabled:
                    pending = get_winsize()
                    emit("\x1b[6n")                       # ask where the real cursor is
                    awaiting = time.monotonic() + 0.5
                else:
                    set_winsize(fd, *get_winsize())
            timeout = 0.016 if animating else None
            if awaiting is not None:
                left = max(0.0, awaiting - time.monotonic())
                timeout = left if timeout is None else min(timeout, left)
            try:
                r, _, _ = select.select([0, fd], [], [], timeout)
            except (InterruptedError, OSError):
                continue

            if awaiting is not None and not r and time.monotonic() >= awaiting:
                finish_resize(sm.screen.cursor.y, sm.screen.cursor.x)   # no answer: keep our own idea
                continue

            if 0 in r:
                data = os.read(0, 4096)
                if not data:
                    break
                if awaiting is not None:
                    m = DSR_RE.search(data)
                    if m:
                        data = DSR_RE.sub(b"", data, 1)
                        finish_resize(int(m.group(1)) - 1, int(m.group(2)) - 1)
                if data:
                    os.write(fd, data)

            if fd in r:
                try:
                    data = os.read(fd, 65536)
                except OSError:
                    break
                if not data:
                    break
                if not enabled:
                    out.write(data)
                    out.flush()
                    continue
                if awaiting is not None:
                    # model is out of sync until the terminal answers: pass through, draw nothing
                    sm.feed(data)
                    out.write(HIDE_SHOW_RE.sub(b"", data))
                    out.flush()
                    continue
                pre = sm.erase()          # clear our cursor before the child draws (keeps scrolling clean)
                sm.feed(data)
                shown = HIDE_SHOW_RE.sub(b"", data)   # keep Termux's real cursor hidden
                post, animating = sm.tick(bulk=len(data) > 2048)
                # one single write so the cursor never flickers between erase and redraw
                out.write(pre.encode("utf-8", "replace") + shown + post.encode("utf-8", "replace"))
                out.flush()
                continue

            if enabled and not r and awaiting is None:
                s, animating = sm.tick()
                emit(s)
    finally:
        if enabled:
            if awaiting is None:
                emit(sm.erase())
            emit("\x1b[?25h")
        termios.tcsetattr(0, termios.TCSADRAIN, old)
        try:
            os.waitpid(pid, 0)
        except ChildProcessError:
            pass


BEGIN = "# >>> smoothcursor >>>"
END = "# <<< smoothcursor <<<"
BASH_BLOCK = (
    BEGIN + "\n"
    'if [ -t 0 ] && [ -z "$SMOOTHCURSOR" ] && [ ! -f "$HOME/.termux/smooth-cursor.off" ] && command -v smoothcursor >/dev/null 2>&1; then\n'
    "    smoothcursor && exit\n"
    "fi\n" + END + "\n"
)
FISH_BLOCK = (
    BEGIN + "\n"
    "if status is-interactive; and not set -q SMOOTHCURSOR; and not test -f $HOME/.termux/smooth-cursor.off; and type -q smoothcursor\n"
    "    smoothcursor; and exit\n"
    "end\n" + END + "\n"
)
RC_FILES = [
    ("~/.bashrc", BASH_BLOCK),
    ("~/.zshrc", BASH_BLOCK),
    ("~/.config/fish/config.fish", FISH_BLOCK),
]


def strip_block(text):
    a = text.find(BEGIN)
    b = text.find(END)
    if a == -1 or b == -1 or b < a:
        return text, False
    return (text[:a] + text[b + len(END):].lstrip("\n")), True


def login_rc():
    """The rc file of the shell Termux actually starts (so autostart works on a fresh install)."""
    name = os.path.basename(os.environ.get("SHELL", "bash"))
    return {"fish": "~/.config/fish/config.fish", "zsh": "~/.zshrc"}.get(name, "~/.bashrc")


def autostart(on):
    own = os.path.expanduser(login_rc())
    for path, block in RC_FILES:
        path = os.path.expanduser(path)
        exists = os.path.exists(path)
        if on and not exists and path != own:
            continue   # never touch rc files of shells the user does not use
        text = open(path).read() if exists else ""
        text, had = strip_block(text)
        if on:
            if text and not text.endswith("\n"):
                text += "\n"
            text += block
        elif not had:
            continue
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(text)
        print(("autostart on: " if on else "autostart off: ") + path)
    if on:
        print("Open a new session to see it. Turn off: smoothcursor autostart off")


def set_conf(key, value):
    if key not in ("enabled", "speed", "color", "size", "width", "height"):
        sys.exit("keys: enabled, speed, color, size, width, height")
    if key in ("size", "width", "height"):
        try:
            if not 1 <= float(value) <= 100:
                raise ValueError
        except ValueError:
            sys.exit("%s must be a number from 1 to 100" % key)
    if key == "size":
        conf_drop = ("width", "height")   # `size` sets both, so forget separate overrides
    else:
        conf_drop = ()
    conf = {}
    try:
        with open(CONF) as f:
            for line in f:
                if "=" in line and not line.lstrip().startswith("#"):
                    k, v = line.split("=", 1)
                    conf[k.strip()] = v.strip()
    except OSError:
        pass
    conf[key] = value
    for k in conf_drop:
        conf.pop(k, None)
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    with open(CONF, "w") as f:
        for k, v in conf.items():
            f.write("%s=%s\n" % (k, v))
    print("saved %s=%s (applies to new sessions)" % (key, value))


def uninstall():
    autostart(False)
    for p in (CONF, os.path.expanduser("~/.termux/smooth-cursor.off")):
        try:
            os.remove(p)
        except OSError:
            pass
    me = os.path.realpath(sys.argv[0])
    try:
        os.remove(me)
        print("removed " + me)
    except OSError as e:
        print("could not remove %s: %s" % (me, e))
    print("Done. Termux is back to stock behavior. (Optional: pip uninstall pyte)")


def cli():
    args = sys.argv[1:]
    if not args:
        return False
    if args[0] == "autostart" and len(args) == 2 and args[1] in ("on", "off"):
        autostart(args[1] == "on")
    elif args[0] == "set" and len(args) == 3:
        set_conf(args[1], args[2])
    elif args[0] == "uninstall":
        uninstall()
    else:
        print(__doc__)
    return True


if __name__ == "__main__":
    if cli():
        sys.exit(0)
    try:
        main()
    except Exception as e:  # terminal already restored by main(); let the caller fall back to a plain shell
        sys.stderr.write("smoothcursor: error: %r\n" % (e,))
        sys.exit(70)
